# Skopiuj do .env (plik jest w .gitignore). Klucz serwisowy NIGDY nie trafia do przeglądarki ani do repo.
# Najprościej: `node scripts/przygotuj-env.mjs` - pobiera klucze przez Supabase CLI i zapisuje ten plik
# bez wyświetlania sekretów.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Folder z materiałami testowymi dla scripts/seed i testów lokalnych (tests/lokalne)
FOLDER_MATERIALOW=C:\sciezka\do\folderu\z\materialami

# Adres aplikacji (GitHub Pages) - linki w mailach logowania (config.toml) i komunikaty skryptów
SITE_URL=https://<konto>.github.io/<repozytorium>/
